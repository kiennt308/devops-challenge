# Example environment configuration for Problem 3.
# Note: In production/real repositories, `.env` should be listed in `.gitignore` and
# populated from `.env.example` or secret managers; `.env` is pre-populated here so
# `docker compose up --build` works out-of-the-box for challenge evaluation.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
DB_HOST=postgres
DB_PORT=5432
DB_POOL_MAX=10
REDIS_HOST=redis
REDIS_PORT=6379
PORT=3000

